<section class="page collection-page">
  <header class="collection-heading">
    <p class="section-kicker">Quiebre / búsqueda</p>
    <h1>Encuentra tu línea.</h1>
  </header>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchInput">Buscar</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Buscar productos">
    <input type="hidden" name="type" value="product">
    <button type="submit">Buscar</button>
  </form>
  {% if search.performed %}
    <p class="search-count">{{ search.results_count }} resultados para “{{ search.terms | escape }}”</p>
    {% paginate search.results by 12 %}
      {% if search.results_count > 0 %}
        <div class="product-grid">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="catalog-box" role="status"><div class="catalog-copy"><p class="section-kicker">Sin resultados</p><h2>No encontramos eso.</h2><p>Prueba con otro término o vuelve a la portada.</p></div><div class="catalog-index" aria-hidden="true"><span>00</span></div></div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{ "name": "Búsqueda principal", "settings": [] }
{% endschema %}

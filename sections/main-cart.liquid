<section class="page cart-page">
  <header class="collection-heading">
    <p class="section-kicker">Quiebre / tu selección</p>
    <h1>Tu bolsa.</h1>
  </header>
  {% if cart.item_count > 0 %}
    {% form 'cart', cart, class: 'cart-form' %}
      <div class="cart-items">
        {% for item in cart.items %}
          {% assign cart_image_alt = item.image.alt | default: item.product.title | escape %}
          <article class="cart-item">
            <a class="cart-item-image" href="{{ item.url }}">
              {% if item.image %}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: cart_image_alt }}{% endif %}
            </a>
            <div class="cart-item-copy">
              <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
              {% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
              <p>{{ item.final_price | money }} c/u</p>
              <label for="Quantity-{{ forloop.index }}">Cantidad</label>
              <input id="Quantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              <a class="remove-link" href="{{ item.url_to_remove }}">Quitar</a>
            </div>
            <strong class="cart-line-total">{{ item.final_line_price | money }}</strong>
          </article>
        {% endfor %}
      </div>
      <div class="cart-summary">
        <button class="button-secondary" type="submit" name="update">Actualizar bolsa</button>
        <p class="cart-total">Subtotal <strong>{{ cart.total_price | money }}</strong></p>
        <p class="cart-disclaimer">Los costos de envío e impuestos se calculan en el siguiente paso.</p>
        <button class="button-primary" type="submit" name="checkout">Continuar al pago <span class="arrow" aria-hidden="true">↗</span></button>
      </div>
    {% endform %}
  {% else %}
    <div class="catalog-box" role="status"><div class="catalog-copy"><p class="section-kicker">Todavía no hay artículos</p><h2>La bolsa está vacía.</h2><p>Cuando publiques productos, podrás volver aquí para revisar tu selección.</p><a class="button-primary" href="{{ routes.root_url }}#catalogo">Volver a explorar <span class="arrow" aria-hidden="true">↗</span></a></div><div class="catalog-index" aria-hidden="true"><span>00</span></div></div>
  {% endif %}
</section>

{% schema %}
{ "name": "Carrito principal", "settings": [] }
{% endschema %}
